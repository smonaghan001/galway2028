<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>News — EMACNS Galway 2028</title>
  <meta name="description" content="Latest news and updates from EMACNS Galway 2028 — the European Masters Athletics Championships Non-Stadia, Galway, Ireland, May 2028." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet" />
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-QJJYYE20G2"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-QJJYYE20G2');
  </script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { font-family: 'Inter', sans-serif; background: #0a0e1a; color: #e8e4dc; line-height: 1.6; }
    a { color: inherit; text-decoration: none; }
    img { display: block; max-width: 100%; }

    :root {
      --gold: #c9a84c;
      --gold-light: #e8c97a;
      --gold-dim: rgba(201,168,76,0.18);
      --green: #1a6b3c;
      --green-light: #2a8f52;
      --navy: #0a0e1a;
      --navy-mid: #111827;
      --navy-card: #161d2e;
      --text: #e8e4dc;
      --text-muted: #9ca3af;
      --radius: 12px;
    }

    nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 100;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 2rem; height: 64px;
      background: rgba(10,14,26,0.92); backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(201,168,76,0.15);
    }
    .nav-brand { display: flex; flex-direction: column; line-height: 1.1; }
    .nav-brand .event-name { font-size: 1rem; font-weight: 700; color: var(--gold-light); letter-spacing: 0.04em; }
    .nav-brand .event-sub { font-size: 0.65rem; color: var(--text-muted); letter-spacing: 0.08em; text-transform: uppercase; }
    .nav-links { display: flex; gap: 1.75rem; align-items: center; }
    .nav-links a { font-size: 0.82rem; font-weight: 500; color: var(--text-muted); letter-spacing: 0.04em; text-transform: uppercase; transition: color 0.2s; }
    .nav-links a:hover, .nav-links a.active { color: var(--gold-light); }
    .nav-cta { background: var(--gold); color: var(--navy) !important; padding: 0.45rem 1rem; border-radius: 6px; font-weight: 600 !important; }
    .nav-cta:hover { background: var(--gold-light) !important; }

    .page-header {
      padding: 9rem 2rem 4rem;
      background: linear-gradient(160deg, #0d1221 0%, #0a0e1a 60%);
      border-bottom: 1px solid rgba(201,168,76,0.12);
    }
    .page-header-inner { max-width: 1100px; margin: 0 auto; }
    .page-eyebrow { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); margin-bottom: 0.6rem; }
    .page-title { font-family: 'Playfair Display', serif; font-size: clamp(2rem, 4vw, 3rem); color: #fff; }

    .news-section { padding: 4rem 2rem; }
    .news-inner { max-width: 1100px; margin: 0 auto; }
    .news-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; }

    .post-card {
      background: var(--navy-card);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: var(--radius);
      overflow: hidden;
      cursor: pointer;
      transition: border-color 0.2s, transform 0.2s;
    }
    .post-card:hover { border-color: var(--gold); transform: translateY(-3px); }
    .post-card-img { width: 100%; height: 200px; object-fit: cover; }
    .post-card-img-placeholder { width: 100%; height: 200px; background: linear-gradient(135deg, #111827 0%, #161d2e 100%); display: flex; align-items: center; justify-content: center; }
    .post-card-img-placeholder span { font-size: 3rem; opacity: 0.3; }
    .post-card-body { padding: 1.5rem; }
    .post-date { font-size: 0.75rem; color: var(--gold); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.5rem; }
    .post-title { font-family: 'Playfair Display', serif; font-size: 1.2rem; color: #fff; margin-bottom: 0.5rem; line-height: 1.3; }
    .post-summary { font-size: 0.85rem; color: var(--text-muted); line-height: 1.6; }
    .post-read-more { font-size: 0.8rem; color: var(--gold); font-weight: 600; margin-top: 1rem; display: inline-block; }

    .modal-overlay {
      display: none; position: fixed; inset: 0; z-index: 200;
      background: rgba(0,0,0,0.85); backdrop-filter: blur(4px);
      overflow-y: auto; padding: 2rem 1rem;
    }
    .modal-overlay.open { display: flex; align-items: flex-start; justify-content: center; }
    .modal {
      background: var(--navy-card);
      border: 1px solid rgba(201,168,76,0.15);
      border-radius: var(--radius);
      max-width: 720px; width: 100%;
      margin: auto; padding: 2.5rem;
      position: relative;
    }
    .modal-close {
      position: absolute; top: 1rem; right: 1rem;
      background: rgba(255,255,255,0.08); border: none; border-radius: 50%;
      width: 36px; height: 36px; font-size: 1.1rem; color: var(--text-muted);
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      transition: background 0.2s;
    }
    .modal-close:hover { background: rgba(255,255,255,0.15); color: #fff; }
    .modal-date { font-size: 0.75rem; color: var(--gold); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.75rem; }
    .modal-title { font-family: 'Playfair Display', serif; font-size: 1.8rem; color: #fff; margin-bottom: 1.5rem; line-height: 1.2; }
    .modal-img { width: 100%; border-radius: 8px; margin-bottom: 1.5rem; max-height: 360px; object-fit: cover; }
    .modal-content { font-size: 0.95rem; color: #c5bfb5; line-height: 1.8; }
    .modal-content p { margin-bottom: 1rem; }

    footer { background: var(--navy); border-top: 1px solid rgba(255,255,255,0.06); padding: 2.5rem 2rem; }
    .footer-inner { max-width: 1100px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
    .footer-brand .brand-name { font-weight: 700; color: var(--gold-light); font-size: 0.95rem; }
    .footer-brand .brand-domain { font-size: 0.75rem; color: var(--text-muted); }
    .footer-copy { font-size: 0.75rem; color: rgba(156,163,175,0.5); }

    /* ─── HAMBURGER BUTTON ───────────────────────────────── */
    .nav-hamburger {
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 4px 6px;
      z-index: 110;
    }
    .nav-hamburger span {
      display: block; width: 24px; height: 2px;
      background: var(--gold-light); border-radius: 2px;
      transition: transform 0.25s, opacity 0.25s;
    }
    .nav-hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-hamburger.open span:nth-child(2) { opacity: 0; }
    .nav-hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .mobile-menu {
      display: none; position: fixed;
      top: 64px; left: 0; right: 0;
      background: rgba(10,14,26,0.98);
      border-bottom: 1px solid rgba(201,168,76,0.2);
      z-index: 99; flex-direction: column;
      padding: 1rem 2rem 1.5rem; gap: 0.25rem;
    }
    .mobile-menu.open { display: flex; }
    .mobile-menu a {
      font-size: 0.9rem; font-weight: 500;
      color: var(--text-muted); letter-spacing: 0.05em;
      text-transform: uppercase; padding: 0.65rem 0;
      border-bottom: 1px solid rgba(255,255,255,0.05);
      transition: color 0.2s;
    }
    .mobile-menu a:last-child { border-bottom: none; }
    .mobile-menu a:hover { color: var(--gold-light); }
    .mobile-menu .nav-cta {
      margin-top: 0.75rem; background: var(--gold);
      color: var(--navy) !important; border-radius: 6px;
      padding: 0.65rem 1.25rem; text-align: center;
      font-weight: 700 !important; border-bottom: none !important;
    }

    @media (max-width: 800px) {
      .nav-links { display: none; }
      .nav-hamburger { display: flex; }
    }
    @media (max-width: 600px) { .modal { padding: 1.5rem; } }
  </style>
</head>
<body>

<nav>
  <div class="nav-brand">
    <span class="event-name">EMACNS Galway 2028</span>
    <span class="event-sub">galway2028.ie · European Masters Athletics</span>
  </div>
  <div class="nav-links">
    <a href="index.html">Home</a>
    <a href="index.html#about">About</a>
    <a href="index.html#events">Events</a>
    <a href="index.html#venue">Venue</a>
    <a href="index.html#travel">Travel</a>
    <a href="index.html#accommodation">Stay</a>
    <a href="news.html" class="active">News</a>
    <a href="index.html#faq">FAQ</a>
    <a href="index.html#volunteer">Volunteer</a>
    <a href="index.html#sponsors">Sponsors</a>
    <a href="index.html#volunteer" class="nav-cta">Get Involved</a>
  </div>
  <button class="nav-hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</nav>

<div class="mobile-menu" id="mobile-menu">
  <a href="index.html">Home</a>
  <a href="index.html#about">About</a>
  <a href="index.html#events">Events</a>
  <a href="index.html#venue">Venue</a>
  <a href="index.html#travel">Travel</a>
  <a href="index.html#accommodation">Stay</a>
  <a href="news.html" class="active">News</a>
  <a href="index.html#faq">FAQ</a>
  <a href="index.html#volunteer">Volunteer</a>
  <a href="index.html#sponsors">Sponsors</a>
  <a href="index.html#volunteer" class="nav-cta">Get Involved</a>
</div>

<div class="page-header">
  <div class="page-header-inner">
    <p class="page-eyebrow">Latest Updates</p>
    <h1 class="page-title">News</h1>
  </div>
</div>

<section class="news-section">
  <div class="news-inner">
    <div class="news-grid">

      <!-- ─── ADD NEW POSTS ABOVE THIS LINE ─── -->

      <!-- POST: Welcome to EMACNS Galway 2028 -->
      <div class="post-card" onclick="openPost('welcome')">
        <div class="post-card-img-placeholder"><span>🏅</span></div>
        <div class="post-card-body">
          <p class="post-date">1 June 2026</p>
          <h2 class="post-title">Welcome to EMACNS Galway 2028</h2>
          <p class="post-summary">We are delighted to announce that Galway will host the European Masters Athletics Championships Non-Stadia in May 2028.</p>
          <span class="post-read-more">Read more →</span>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- POST MODALS -->

<!-- Modal: Welcome -->
<div class="modal-overlay" id="modal-welcome" onclick="closeModal(event, 'welcome')">
  <div class="modal">
    <button class="modal-close" onclick="closePost('welcome')">✕</button>
    <p class="modal-date">1 June 2026</p>
    <h2 class="modal-title">Welcome to EMACNS Galway 2028</h2>
    <div class="modal-content">
      <p>We are thrilled to officially launch the website for EMACNS Galway 2028 — the European Masters Athletics Championships Non-Stadia, coming to Galway, Ireland in May 2028.</p>
      <p>Planning is well underway and we look forward to welcoming masters athletes from over 20 nations to one of Ireland's most vibrant and beautiful cities.</p>
      <p>Over the coming months we will be sharing updates on the event programme, venues, accommodation and everything you need to know to make the most of your time in Galway.</p>
      <p>Stay tuned — and if you'd like to volunteer or discuss sponsorship opportunities, please visit the relevant sections of this website.</p>
      <p><em>The EMACNS Galway 2028 Organising Committee</em></p>
    </div>
  </div>
</div>

<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <div class="brand-name">EMACNS Galway 2028</div>
      <div class="brand-domain">galway2028.ie</div>
    </div>
    <div class="footer-copy">© 2028 EMACNS Galway 2028 · galway2028.ie</div>
  </div>
</footer>

<!-- ─── COOKIE CONSENT ───────────────────────────────────────── -->
<div id="cookie-banner" style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:999;background:#0d1221;border-top:1px solid rgba(201,168,76,0.25);padding:1.25rem 2rem;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:1rem;">
  <p style="font-size:0.82rem;color:#c5bfb5;max-width:700px;margin:0;">
    We use cookies to analyse site traffic via Google Analytics. No personal data is shared with third parties.
    <a href="https://policies.google.com/privacy" target="_blank" rel="noopener" style="color:var(--gold);text-decoration:underline;text-underline-offset:3px;">Learn more</a>
  </p>
  <div style="display:flex;gap:0.75rem;flex-shrink:0;">
    <button onclick="acceptCookies()" style="background:var(--gold);color:#0a0e1a;border:none;border-radius:6px;padding:0.5rem 1.2rem;font-size:0.82rem;font-weight:700;font-family:inherit;cursor:pointer;">Accept</button>
    <button onclick="declineCookies()" style="background:transparent;color:var(--text-muted);border:1px solid rgba(255,255,255,0.15);border-radius:6px;padding:0.5rem 1.2rem;font-size:0.82rem;font-weight:500;font-family:inherit;cursor:pointer;">Decline</button>
  </div>
</div>

<script>
  // Hamburger menu
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  hamburger.addEventListener('click', () => {
    const isOpen = mobileMenu.classList.toggle('open');
    hamburger.classList.toggle('open', isOpen);
    hamburger.setAttribute('aria-expanded', String(isOpen));
  });
  document.addEventListener('click', e => {
    if (!hamburger.contains(e.target) && !mobileMenu.contains(e.target)) {
      hamburger.classList.remove('open');
      mobileMenu.classList.remove('open');
    }
  });

  function openPost(id) {
    document.getElementById('modal-' + id).classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closePost(id) {
    document.getElementById('modal-' + id).classList.remove('open');
    document.body.style.overflow = '';
  }
  function closeModal(e, id) {
    if (e.target === document.getElementById('modal-' + id)) closePost(id);
  }
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') document.querySelectorAll('.modal-overlay.open').forEach(m => { m.classList.remove('open'); document.body.style.overflow = ''; });
  });

  // Cookie consent
  (function() {
    const consent = localStorage.getItem('cookie-consent');
    if (!consent) { document.getElementById('cookie-banner').style.display = 'flex'; }
    else if (consent === 'declined') { window['ga-disable-G-QJJYYE20G2'] = true; }
  })();
  function acceptCookies() { localStorage.setItem('cookie-consent','accepted'); document.getElementById('cookie-banner').style.display='none'; }
  function declineCookies() { localStorage.setItem('cookie-consent','declined'); window['ga-disable-G-QJJYYE20G2']=true; document.getElementById('cookie-banner').style.display='none'; }
</script>

</body>
</html>
